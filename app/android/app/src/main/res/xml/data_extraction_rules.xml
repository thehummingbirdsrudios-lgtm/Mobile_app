<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup or device transfer of app data: the session lives in the
     keystore and business data on the server; restoring a stale session on a
     new device would bypass sign-in (docs/security/auth.md). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
